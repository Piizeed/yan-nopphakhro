# Copy to .env. Never commit .env or data/.
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=data/members.sqlite
# Promote a registered account using: node scripts/admin.mjs email

# Leave blank to disable payment collection until you are ready.
PAYMENT_BANK=PromptPay
PAYMENT_ACCOUNT=
PAYMENT_NAME=
# manual = staff approval; easyslip = verified slip worker. No card gateway yet.
PAYMENT_MODE=manual
# Configure only after opening a provider account and confirming service eligibility.
# Register the receiving account with EasySlip first. Keep this secret server-side.
EASYSLIP_API_KEY=
EASYSLIP_RECEIVER_ACCOUNT=
EASYSLIP_RECEIVER_BANK=
# Set to 1 when deployed behind HTTPS.
COOKIE_SECURE=0
